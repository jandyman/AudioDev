; Pitch shifter pipeline — see Python_STM32/docs/audio_graph_architecture.md
; One audio input, two audio outputs (L = raw input dry, R = pitch-shifted).

(graph pitch_shifter
 (port input audio_in lpf.in)
 (port output audio_out_l audio_in)
 (port output audio_out_r mixer.out)

 (block lpf input_lpf :fc 10000)
 (block zc zero_crossing_detector)
 (block atk attack_detector)
 (block pd pitch_detector)
 (block lc loop_controller :pitch_ratio 0.5)
 (block dtd triple_tap_delay)
 (block mixer mixer3)

 (connect lpf.out zc.in atk.in pd.in dtd.audio_in)
 (connect zc.zc_out lc.zc_impulse)
 (connect atk.trigger lc.attack_impulse pd.reset)
 (connect pd.P lc.P_samples)
 (connect pd.sigma_sel lc.sigma_samples)
 (connect pd.qualified lc.qualified)
 (connect lc.tap1_delay_ms dtd.delay1_ms)
 (connect lc.tap2_delay_ms dtd.delay2_ms)
 (connect lc.tap3_delay_ms dtd.delay3_ms)
 (connect dtd.tap1 mixer.in1)
 (connect dtd.tap2 mixer.in2)
 (connect dtd.tap3 mixer.in3)
 (connect lc.gain1 mixer.gain1)
 (connect lc.gain2 mixer.gain2)
 (connect lc.gain3 mixer.gain3)
 (connect atk.active_gain lc.active_gain))
